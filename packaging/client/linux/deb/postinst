#!/bin/sh

set -e

if [ "$1" = configure ] && [ -f "${DPKG_ROOT:-}/etc/plank/client.conf" ]; then
  "${DPKG_ROOT:-}/usr/libexec/plank-client-update-policy" \
    "${DPKG_ROOT:-}/etc/plank" \
    "${DPKG_ROOT:-}/usr/share/doc/plank-client/client.conf.example"
fi

if [ "$1" = configure ] || [ "$1" = abort-upgrade ] || \
   [ "$1" = abort-deconfigure ] || [ "$1" = abort-remove ]; then
  if [ -z "${DPKG_ROOT:-}" ]; then
    if [ -x /usr/bin/udevadm ]; then
      /usr/bin/udevadm control --reload-rules || true
      /usr/bin/udevadm trigger --action=change \
        --subsystem-match=hidraw || true
      /usr/bin/udevadm trigger --action=change \
        --subsystem-match=input || true
    fi

  fi
fi
