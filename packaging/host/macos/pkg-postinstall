#!/bin/bash
set -euo pipefail
source "$(/usr/bin/dirname "$0")/pkg-common.sh"
preflight "${3:-}"
verify_app
verify_microphone_driver
[[ $(/usr/libexec/PlistBuddy -c 'Print :PLANKVersion' "$app/Contents/Info.plist") = "$version" ]] || fail 'Payload version mismatch'
initialize_state
prepare_machine_authority
start_roles
open_permission_setup
echo 'PLANK Host installed. Open PLANK Host in Applications for privacy setup. Configuration and keys preserved.'
echo 'Restart this Mac to finish loading the updated PLANK Microphone driver. Save your work first; restarting closes applications and remote sessions. You can restart later.'
