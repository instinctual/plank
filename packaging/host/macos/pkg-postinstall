#!/bin/bash
set -euo pipefail
source "$(/usr/bin/dirname "$0")/pkg-common.sh"
preflight "${3:-}"
verify_app
verify_microphone_driver
[[ $(/usr/libexec/PlistBuddy -c 'Print :PLANKVersion' "$app/Contents/Info.plist") = "$version" ]] || fail 'Payload version mismatch'
initialize_state
configure_host finish
prepare_machine_authority
start_roles
open_permission_setup
echo 'PLANK Host installed. Complete approval in the PLANK Host setup window. Configuration and keys preserved.'
echo 'Restart this Mac to finish loading the PLANK audio devices. Save your work first; restarting closes applications and remote sessions. You can restart later.'
