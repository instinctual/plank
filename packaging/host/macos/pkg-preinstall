#!/bin/bash
set -euo pipefail
source "$(/usr/bin/dirname "$0")/pkg-common.sh"
preflight "${3:-}"
# Installer runs this after authorization, before changing files or stopping
# services. A failed query must never be treated as confirmed FileVault off.
filevault_status=$(/usr/bin/fdesetup status) || fail 'Unable to verify FileVault status. Check System Settings > Privacy & Security > FileVault, then retry installation.'
[[ $filevault_status = 'FileVault is Off.' ]] || fail 'FileVault must be off before installing PLANK Host. Open System Settings > Privacy & Security > FileVault, turn it off, wait for it to finish, then reopen this installer.'
# Discover unsafe state/log paths before stopping a working Host or replacing
# its app. Repeating this in postinstall is intentional and idempotent.
initialize_state
owner=$(console_uid)
stop_roles
[[ $(console_uid) = "$owner" ]] || fail 'Console changed during shutdown; retry installation'
