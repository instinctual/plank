#!/bin/bash
set -euo pipefail
source "$(/usr/bin/dirname "$0")/pkg-common.sh"
preflight "${3:-}"
# Recheck before changing files or stopping services, including CLI installs
# and FileVault changes since the distribution's initial requirements check.
[[ $(/usr/bin/fdesetup status) = 'FileVault is Off.' ]] || fail 'FileVault must be off before installing PLANK Host. Open System Settings > Privacy & Security > FileVault, turn it off, wait for it to finish, then reopen this installer.'
# Discover unsafe state/log paths before stopping a working Host or replacing
# its app. Repeating this in postinstall is intentional and idempotent.
initialize_state
owner=$(console_uid)
stop_roles
[[ $(console_uid) = "$owner" ]] || fail 'Console changed during shutdown; retry installation'
