#!/usr/bin/env bash

set -euo pipefail

config_file=/etc/plank/host.conf
output_file=/etc/X11/xorg.conf.d/99-plank-headless.conf
edid_dir=/usr/share/plank/display
cleanup_only=false
requested_layout=
requested_mode_1=
requested_mode_2=
requested_primary_output=-1
primary_output_supplied=false

usage() {
  echo "usage: $0 [--cleanup] [--config FILE] [--output FILE] [--edid-dir DIRECTORY] [--layout LAYOUT --mode-1 MODE [--mode-2 MODE] [--primary-output 0|1]]" >&2
}

while (($#)); do
  case $1 in
    --cleanup)
      cleanup_only=true
      shift
      ;;
    --config)
      (($# >= 2)) || { usage; exit 2; }
      config_file=$2
      shift 2
      ;;
    --output)
      (($# >= 2)) || { usage; exit 2; }
      output_file=$2
      shift 2
      ;;
    --edid-dir)
      (($# >= 2)) || { usage; exit 2; }
      edid_dir=$2
      shift 2
      ;;
    --layout)
      (($# >= 2)) || { usage; exit 2; }
      requested_layout=$2
      shift 2
      ;;
    --mode-1)
      (($# >= 2)) || { usage; exit 2; }
      requested_mode_1=$2
      shift 2
      ;;
    --mode-2)
      (($# >= 2)) || { usage; exit 2; }
      requested_mode_2=$2
      shift 2
      ;;
    --primary-output)
      (($# >= 2)) || { usage; exit 2; }
      requested_primary_output=$2
      primary_output_supplied=true
      shift 2
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

[[ $output_file = /* && $edid_dir = /* ]] || {
  echo "PLANK display paths must be absolute" >&2
  exit 1
}

startup_policy=$(awk '
  function trim(value) {
    sub(/^[[:space:]]+/, "", value)
    sub(/[[:space:]]+$/, "", value)
    return value
  }
  /^[[:space:]]*([#;]|$)/ { next }
  /^[[:space:]]*\[/ {
    section = $0
    sub(/^[[:space:]]*\[/, "", section)
    sub(/\][[:space:]]*$/, "", section)
    section = trim(section)
    next
  }
  section == "display" {
    separator = index($0, "=")
    if (!separator) {
      print "invalid line in [display]: " $0 > "/dev/stderr"
      exit 1
    }
    key = trim(substr($0, 1, separator - 1))
    value = trim(substr($0, separator + 1))
    if (key != "startup_layout") {
      print "unknown [display] option: " key > "/dev/stderr"
      exit 1
    }
    if (seen[key]++) {
      print "duplicate [display] option: " key > "/dev/stderr"
      exit 1
    }
    values[key] = value
  }
  END {
    if (!values["startup_layout"]) values["startup_layout"] = "physical"
    print values["startup_layout"]
  }
' "$config_file") || exit 1

case $startup_policy in
  physical|virtual) ;;
  *)
    echo "invalid display.startup_layout: ${startup_policy}" >&2
    exit 1
    ;;
esac

active_layout=
output_mode_1=
output_mode_2=
if [[ -n $requested_layout || -n $requested_mode_1 || -n $requested_mode_2 || $primary_output_supplied == true ]]; then
  [[ -n $requested_layout && -n $requested_mode_1 ]] || {
    echo "a requested display transition requires --layout and --mode-1" >&2
    exit 2
  }
  if [[ $startup_policy == physical ]]; then
    echo "persistent virtual display transitions are disabled by display.startup_layout" >&2
    exit 1
  fi
  active_layout=$requested_layout
  output_mode_1=$requested_mode_1
  if [[ $active_layout == dual-horizontal ]]; then
    [[ -n $requested_mode_2 ]] || {
      echo "a dual display transition requires --mode-2" >&2
      exit 2
    }
    output_mode_2=$requested_mode_2
    [[ $primary_output_supplied == false || $requested_primary_output == 0 || $requested_primary_output == 1 ]] || {
      echo "invalid dual-display primary output index" >&2
      exit 2
    }
  elif [[ -n $requested_mode_2 ]]; then
    echo "--mode-2 is valid only for a dual display transition" >&2
    exit 2
  else
    [[ $primary_output_supplied == false || $requested_primary_output == 0 ]] || {
      echo "invalid single-display primary output index" >&2
      exit 2
    }
    output_mode_2=1920x1080
  fi
elif [[ $startup_policy == virtual ]]; then
  # This is only the GDM/login baseline. The authenticated bookmark selects
  # the active one- or two-output topology and exact modes at connection time.
  active_layout=single
  output_mode_1=1920x1080
  output_mode_2=1920x1080
fi
case $active_layout in
  ''|single|dual-horizontal) ;;
  *)
    echo "invalid requested display layout: ${active_layout}" >&2
    exit 1
    ;;
esac
mode_dimensions() {
  case $1 in
    1024x2160) echo '1024 2160' ;;
    1280x2160) echo '1280 2160' ;;
    1920x1080) echo '1920 1080' ;;
    1920x1200) echo '1920 1200' ;;
    2560x1440) echo '2560 1440' ;;
    2560x1600) echo '2560 1600' ;;
    2560x2160) echo '2560 2160' ;;
    3440x1440) echo '3440 1440' ;;
    3840x1600) echo '3840 1600' ;;
    3840x2160) echo '3840 2160' ;;
    4096x2160) echo '4096 2160' ;;
    5120x2160) echo '5120 2160' ;;
    *) return 1 ;;
  esac
}

generated_marker="# Generated by PLANK; do not edit."

remove_owned_overlay_for_uninstall() {
  [[ -e $output_file ]] || return 0
  if ! head -n 1 -- "$output_file" | grep -Fxq -- "$generated_marker"; then
    echo "refusing to remove a display configuration not owned by PLANK: ${output_file}" >&2
    exit 1
  fi
  rm -f -- "$output_file"
  echo "Removed the PLANK virtual display overlay; the running X server is unchanged"
}

if [[ $cleanup_only == true ]]; then
  remove_owned_overlay_for_uninstall
  exit 0
fi

[[ -r $config_file ]] || {
  echo "PLANK host configuration is not readable: ${config_file}" >&2
  exit 1
}

display_manager_active() {
  systemctl is-active --quiet display-manager.service 2>/dev/null
}

remove_overlay() {
  [[ -e $output_file ]] || return 0
  if ! head -n 1 -- "$output_file" | grep -Fxq -- "$generated_marker"; then
    echo "refusing to remove a display configuration not owned by PLANK: ${output_file}" >&2
    exit 1
  fi
  if display_manager_active; then
    echo "refusing to change the display topology while the display manager is active; reboot to apply the configuration" >&2
    exit 1
  fi
  rm -f -- "$output_file"
  echo "PLANK virtual outputs are disabled"
}

if [[ $startup_policy == physical ]]; then
  remove_overlay
  exit 0
fi

read -r output_1_width output_1_height < <(mode_dimensions "$output_mode_1") || {
  echo "invalid virtual output 1 mode: ${output_mode_1}" >&2
  exit 1
}
read -r output_2_width output_2_height < <(mode_dimensions "$output_mode_2") || {
  echo "invalid virtual output 2 mode: ${output_mode_2}" >&2
  exit 1
}
required_edids=(
  "virtual-1.edid"
  "virtual-2.edid"
)
for edid_name in "${required_edids[@]}"; do
  edid_file="${edid_dir}/${edid_name}"
  [[ -r $edid_file ]] || {
    echo "packaged PLANK EDID is not readable: ${edid_file}" >&2
    exit 1
  }
  # Mutter 40 requests at most 400 bytes from the XRandR EDID property. Keep
  # the complete identity and exact timing pool within three 128-byte blocks.
  expected_edid_size=384
  [[ $(wc -c <"$edid_file") -eq $expected_edid_size ]] || {
    echo "packaged PLANK EDID has the wrong size (expected ${expected_edid_size} bytes): ${edid_file}" >&2
    exit 1
  }
done

# NVIDIA constrains later RandR MetaModes to the boot-time X screen's virtual
# dimensions even though xrandr advertises a larger protocol maximum. Reserve
# enough space for two qualified 4096-wide virtual displays so a live
# transition can move the secondary output immediately after the primary
# without the driver silently overlapping them. This is a capacity ceiling;
# the active desktop remains the exact requested one- or two-display layout.
maximum_canvas_width=8192
maximum_canvas_height=2160

if [[ $active_layout == single ]]; then
  # Keep the second virtual connector available to Xorg but inactive. The host
  # supervisor marks it non-desktop after Xorg starts, hiding it from GNOME
  # until a dual-layout request hot-plugs it through XRandR.
  connected_monitors="DFP-0, DFP-2"
  custom_edid="DFP-0:${edid_dir}/virtual-1.edid; DFP-2:${edid_dir}/virtual-2.edid"
  metamodes="DFP-0: ${output_mode_1} +0+0, DFP-2: NULL"
else
  connected_monitors="DFP-0, DFP-2"
  custom_edid="DFP-0:${edid_dir}/virtual-1.edid; DFP-2:${edid_dir}/virtual-2.edid"
  if [[ $requested_primary_output == 1 ]]; then
    # Keep the primary connector first even when it sits on the right. Flame
    # uses this order to choose its main UI after Xorg restarts.
    metamodes="DFP-0: ${output_mode_2} +${output_1_width}+0, DFP-2: ${output_mode_1} +0+0"
  else
    metamodes="DFP-0: ${output_mode_1} +0+0, DFP-2: ${output_mode_2} +${output_1_width}+0"
  fi
fi

output_directory=${output_file%/*}
install -d -m 0755 -- "$output_directory"
temporary_file=$(mktemp -- "${output_file}.tmp.XXXXXX")
cleanup() {
  rm -f -- "$temporary_file"
}
trap cleanup EXIT

cat >"$temporary_file" <<EOF
${generated_marker}
# Boot source: /etc/plank/host.conf [display]
# The host supervisor may replace this owned overlay with a validated GDM-only request.

Section "ServerFlags"
    Option "DefaultServerLayout" "PLANK Virtual Display Layout"
EndSection

Section "ServerLayout"
    Identifier "PLANK Virtual Display Layout"
    Screen 0 "PLANK Virtual Display Screen" 0 0
EndSection

Section "Device"
    Identifier "PLANK NVIDIA GPU"
    Driver "nvidia"
    Option "AllowEmptyInitialConfiguration" "True"
    Option "ConnectedMonitor" "${connected_monitors}"
    Option "UseDisplayDevice" "${connected_monitors}"
    Option "CustomEDID" "${custom_edid}"
    Option "MetaModes" "${metamodes}"
    Option "nvidiaXineramaInfoOrder" "DFP-0, DFP-2"
    Option "HardDPMS" "False"
    Option "Interactive" "False"
EndSection

Section "Screen"
    Identifier "PLANK Virtual Display Screen"
    Device "PLANK NVIDIA GPU"
    DefaultDepth 30
    SubSection "Display"
        Depth 30
        Virtual ${maximum_canvas_width} ${maximum_canvas_height}
    EndSubSection
EndSection
EOF
chmod 0644 -- "$temporary_file"

if [[ -e $output_file ]] && cmp -s -- "$temporary_file" "$output_file"; then
  echo "PLANK virtual display topology is already current: ${active_layout} ${output_mode_1} ${output_mode_2}"
  exit 0
fi
if display_manager_active; then
  echo "refusing to change the display topology while the display manager is active; reboot to apply the configuration" >&2
  exit 1
fi
mv -f -- "$temporary_file" "$output_file"
trap - EXIT
echo "Prepared PLANK virtual display topology: ${active_layout} ${output_mode_1} ${output_mode_2}"
